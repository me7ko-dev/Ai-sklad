# Копие на този файл с име .env.local се ползва само ако пускате приложението на компютър.
# За телефона същите стойности се въвеждат във Vercel → Settings → Environment Variables.

# --- Задължителни ---
# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → Secret key (започва с sb_secret_)
SUPABASE_SECRET_KEY=sb_secret_...
# ПИН код за вход в приложението (поне 6 цифри)
APP_PIN=123456

# --- За гласа ---
# platform.openai.com → API keys (превръща гласа в текст)
OPENAI_API_KEY=sk-...
# console.anthropic.com → API keys (Claude разбира какво е казано)
ANTHROPIC_API_KEY=sk-ant-...

# --- По желание ---
# Името на магазина в текста на поръчката
SHOP_NAME=Магазин Здравец
# По-евтин модел на Claude (по подразбиране е claude-opus-5)
# ANTHROPIC_MODEL=claude-sonnet-5
